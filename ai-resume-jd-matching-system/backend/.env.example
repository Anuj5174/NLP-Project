# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/resume_matcher_db

# Security & JWT Authentication
SECRET_KEY=your-super-secret-jwt-key-replace-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Application Settings
PROJECT_NAME="AI Resume Matcher"
VERSION=1.0.0
DEBUG=True

# Email Service Configuration
# EMAIL_METHOD options: "gmail" or "sendgrid"
EMAIL_METHOD=gmail

# Gmail SMTP Settings (if EMAIL_METHOD=gmail)
# Note: Use a 16-character Google App Password (not your normal Gmail password)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# SendGrid API Settings (if EMAIL_METHOD=sendgrid)
SENDGRID_API_KEY=SG.your_api_key_here
SENDGRID_FROM_EMAIL=verified-sender@yourdomain.com
SENDGRID_FROM_NAME="RecruitAI"
